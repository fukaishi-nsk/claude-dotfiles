<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nsketch.rc-restart-on-update</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/claude-dotfiles/launchd/rc-restart-on-update/check.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/rc-restart-on-update.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/rc-restart-on-update.log</string>
</dict>
</plist>
