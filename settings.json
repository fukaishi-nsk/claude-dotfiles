{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "additionalDirectories": [
      "~/.claude",
      "~/claude-dotfiles",
      "~/Downloads"
    ],
    "allow": [
      "Bash(npx wrangler deploy*)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(iconv:*)",
      "Bash(python3:*)",
      "Bash(jq:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",

      "mcp__claude_ai_Google_Calendar__list_events",
      "mcp__claude_ai_Google_Calendar__search_events",
      "mcp__claude_ai_Google_Calendar__get_event",
      "mcp__claude_ai_Google_Calendar__list_calendars",

      "mcp__claude_ai_Google_Drive__search_files",
      "mcp__claude_ai_Google_Drive__read_file_content",
      "mcp__claude_ai_Google_Drive__download_file_content",
      "mcp__claude_ai_Google_Drive__get_file_metadata",
      "mcp__claude_ai_Google_Drive__list_recent_files",
      "mcp__claude_ai_Google_Drive__create_file",

      "mcp__claude_ai_Slack__slack_read_channel",
      "mcp__claude_ai_Slack__slack_read_thread",
      "mcp__claude_ai_Slack__slack_read_file",
      "mcp__claude_ai_Slack__slack_search_channels",
      "mcp__claude_ai_Slack__slack_search_users",
      "mcp__claude_ai_Slack__slack_search_public",
      "mcp__claude_ai_Slack__slack_read_user_profile",
      "mcp__claude_ai_Slack__slack_send_message",

      "mcp__claude_ai_Linear__list_issues",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Linear__list_comments",
      "mcp__claude_ai_Linear__list_teams",
      "mcp__claude_ai_Linear__list_users",
      "mcp__claude_ai_Linear__save_issue",
      "mcp__claude_ai_Linear__save_comment",
      "mcp__claude_ai_Linear__prepare_attachment_upload",
      "mcp__claude_ai_Linear__create_attachment_from_upload",

      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__get_thread",
      "mcp__claude_ai_Gmail__get_message",
      "mcp__claude_ai_Gmail__list_drafts",

      "mcp__notion__notion-search",
      "mcp__notion__notion-fetch",
      "mcp__notion__notion-query-data-sources",
      "mcp__notion__notion-get-users",

      "mcp__claude_ai_nanco__whoami",
      "mcp__claude_ai_nanco__search_items",
      "mcp__claude_ai_nanco__get_item",
      "mcp__claude_ai_nanco__list_folders",
      "mcp__claude_ai_nanco__get_folder_tree",
      "mcp__claude_ai_nanco__get_stock_history",

      "WebSearch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "{ git -C \"$HOME/claude-dotfiles\" pull --quiet && \"$HOME/claude-dotfiles/setup.sh\" >/dev/null 2>&1; } || echo '⚠️ dotfiles同期に失敗しました（コンフリクトの可能性）。ユーザーにこの旨を伝え、git -C ~/claude-dotfiles status での確認を促してください。'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v osascript >/dev/null 2>&1; then osascript -e 'display notification \"Claude Code が確認を待っています\" with title \"Claude Code\" sound name \"Submarine\"'; else powershell.exe -NoProfile -Command \"Add-Type -AssemblyName System.Windows.Forms; Add-Type -AssemblyName System.Drawing; \\$n = New-Object System.Windows.Forms.NotifyIcon; \\$n.Icon = [System.Drawing.SystemIcons]::Information; \\$n.Visible = \\$true; \\$n.ShowBalloonTip(4000, 'Claude Code', 'Claude Code is waiting for your confirmation', 'Info'); Start-Sleep 5; \\$n.Dispose()\" >/dev/null 2>&1; fi"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "theme": "dark",
  "skipWorkflowUsageWarning": true
}
